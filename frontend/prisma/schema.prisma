// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// prisma/schema.prisma
model User {
  // Authentication fields
  id              String    @id @default(cuid())
  name            String?
  username        String?   @unique
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  password        String?   // Add this field for email/password authentication
  verificationToken String? // Add this field for email verification
  accounts        Account[]
  sessions        Session[]

  // Custom fields
  accuracyPoints      Int      @default(0)
  accuracyScore       Float    @default(0)
  weightedScore       Float    @default(0)
  polls               Poll[]   // Polls created by the user
  votes               Vote[]   // Votes cast by the user
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Player {
  id      Int    @id @default(autoincrement())
  name    String
  position String
  team    String
  votes   Vote[] // Relation to Vote
  pollsAsPlayer1 Poll[] @relation("Player1") // Reverse relation to Poll (player1)
  pollsAsPlayer2 Poll[] @relation("Player2") // Reverse relation to Poll (player2)
}


model Poll {
  id              Int      @id @default(autoincrement())
  player1Id       Int
  player2Id       Int
  creatorId       String
  createdAt       DateTime @default(now())
  player1         Player   @relation("Player1", fields: [player1Id], references: [id])
  player2         Player   @relation("Player2", fields: [player2Id], references: [id])
  creator         User     @relation(fields: [creatorId], references: [id])
  votes           Vote[]
  player1Points   Float?   // Points scored by Player 1 in the real-world game
  player2Points   Float?   // Points scored by Player 2 in the real-world game
  winningPlayerId Int?     // The player who actually performed better (based on real-world points)
  status String @default("open") // "open", "closed"
}

model Vote {
  id        Int      @id @default(autoincrement())
  pollId    Int
  userId    String
  playerId  Int
  createdAt DateTime @default(now())
  isCorrect Boolean? // Whether the vote was correct (based on real-world outcome)
  poll      Poll     @relation(fields: [pollId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  player    Player   @relation(fields: [playerId], references: [id])
}