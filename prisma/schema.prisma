// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  username            String   @unique
  email               String   @unique
  passwordHash        String
  participationPoints Int      @default(0)
  accuracyPoints      Int      @default(0)
  accuracyScore       Float    @default(0)
  polls               Poll[]
  votes               Vote[]
}

model Player {
  id      Int    @id @default(autoincrement())
  name    String
  position String
  team    String
  pollsAsPlayer1 Poll[] @relation("Player1") // Relation to Poll (player1)
  pollsAsPlayer2 Poll[] @relation("Player2") // Relation to Poll (player2)
  votes   Vote[] // Reverse relation to Vote
}

model Poll {
  id        Int      @id @default(autoincrement())
  player1Id Int
  player2Id Int
  creatorId Int
  createdAt DateTime @default(now())
  player1   Player   @relation("Player1", fields: [player1Id], references: [id]) // Relation to Player (player1)
  player2   Player   @relation("Player2", fields: [player2Id], references: [id]) // Relation to Player (player2)
  creator   User     @relation(fields: [creatorId], references: [id])
  votes     Vote[]
}

model Vote {
  id        Int      @id @default(autoincrement())
  pollId    Int
  userId    Int
  playerId  Int
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  player    Player   @relation(fields: [playerId], references: [id])
}