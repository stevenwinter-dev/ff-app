// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// prisma/schema.prisma

model User {
  // Authentication fields
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  // Custom fields
  participationPoints Int      @default(0)
  accuracyPoints      Int      @default(0)
  accuracyScore       Float    @default(0)
  polls               Poll[]   // Polls created by the user
  votes               Vote[]   // Votes cast by the user
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Player {
  id      Int    @id @default(autoincrement())
  name    String
  position String
  polls   Poll[] // Many-to-many relationship with Poll
  votes   Vote[] // Reverse relation to Vote
}

model Poll {
  id        Int      @id @default(autoincrement())
  creatorId String
  createdAt DateTime @default(now())
  players   Player[] // Many-to-many relationship with Player
  creator   User     @relation(fields: [creatorId], references: [id])
  votes     Vote[]
}

model Vote {
  id        Int      @id @default(autoincrement())
  pollId    Int
  userId    String
  playerId  Int
  createdAt DateTime @default(now())
  poll      Poll     @relation(fields: [pollId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  player    Player   @relation(fields: [playerId], references: [id])
}